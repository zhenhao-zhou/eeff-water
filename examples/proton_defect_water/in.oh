# EeFF-water hydroxide-defect example: 511 H2O + 1 OH-, 300 K, 1 atm, 1 ns production.

variable sname index 511h2o_1oh

units real
newton on
boundary p p p
atom_style hybrid electron bond
bond_style harmonic

read_data data.${sname}
include ../../parameters/eeff_water_pair_style.inc

bond_coeff 1 10000.0 1.0 -0.1
special_bonds lj/coul 1.0 1.0 1.0
comm_modify vel yes

# Nuclear and electronic translational temperatures are evaluated separately.
group nuclei type 1 2
group electrons type 3
compute temp_nuclei nuclei temp
compute temp_electrons electrons temp

# Barostat pressure: nuclear kinetic contribution plus the total interaction virial.
compute p_nuc_only all pressure temp_nuclei

compute energies all pair eff/cut
variable eke equal c_energies[1]
variable epauli equal c_energies[2]
variable ecoul equal c_energies[3]
variable erres equal c_energies[4]
variable eadd equal c_energies[5]

thermo 100
thermo_style custom step density c_temp_nuclei c_temp_electrons etotal ebond pe ke v_eke v_epauli v_ecoul v_erres v_eadd
dump nuclei_wrapped nuclei custom 200 ${sname}.reaxc id type x y z
dump nuclei_unwrapped nuclei custom 200 ${sname}.unwrap.lammpstrj id type xu yu zu
dump_modify nuclei_wrapped sort id
dump_modify nuclei_unwrapped sort id
compute electronic_state all property/atom spin eradius erforce

# Relax the initial electronic state.
min_style cg
min_modify line backtrack
min_modify dmax 0.01
minimize 0.0 1.0 200 100000
min_style sd
minimize 0.0 1.0 100 200000

timestep 0.2
neigh_modify one 100000
neigh_modify page 1000000
velocity all create 100 1102 mom yes rot yes dist gaussian

# Short low-temperature initialization.
fix init_nuclei nuclei nvt temp 100.0 100.0 100
fix init_electrons electrons nvt temp 50.0 50.0 100
fix radial_thermostat electrons rnvt/eff temp 1.0 1.0 1
fix remove_momentum all momentum 100 linear 1 1 1 rescale angular
run 1000
unfix init_nuclei
unfix init_electrons

# Production thermostats.
fix thermostat_nuclei nuclei temp/csvr 300.0 300.0 10.0 54321
fix_modify thermostat_nuclei temp temp_nuclei
fix thermostat_electrons electrons temp/csvr 300.0 300.0 100.0 98765
fix_modify thermostat_electrons temp temp_electrons

fix barostat all nph iso 1.0 1.0 5000.0
fix_modify barostat press p_nuc_only

run 5000000
